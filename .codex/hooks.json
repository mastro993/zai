{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/install.sh\"",
            "timeout": 300,
            "statusMessage": "Installing dependencies"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$(git rev-parse --show-toplevel)/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"$(git rev-parse --show-toplevel)/.agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec lefthook run agent-fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/quality.mjs\" stop",
            "timeout": 900,
            "statusMessage": "Running repository checks"
          }
        ]
      }
    ]
  }
}
