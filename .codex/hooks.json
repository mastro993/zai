{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ ! -f \"$(git rev-parse --show-toplevel)/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"$(git rev-parse --show-toplevel)/.agents/skills/impeccable/scripts/hook.mjs\"",
            "statusMessage": "Checking UI changes",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node .agents/hooks/run-lefthook.mjs lefthook run agent-fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node .agents/hooks/run-lefthook.mjs lefthook run agent-stop",
            "timeout": 900,
            "statusMessage": "Running repository checks"
          }
        ]
      }
    ]
  }
}
