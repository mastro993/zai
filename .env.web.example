# Copy to .env.web to override local web mode settings.
# Vite loads this file automatically with `vite dev --mode web`.
VITE_ZAI_API_ORIGIN=http://127.0.0.1:3000

# Persistent Zai Home for zai-server. Path must be absolute.
# Leave unset to use a temporary Zai Home for each `pnpm dev:web` run.
# ZAI_HOME=/absolute/path/to/.zai
