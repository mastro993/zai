{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/run-lefthook.mjs\" run agent-fix"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/run-lefthook.mjs\" run agent-stop",
        "timeoutSec": 900
      }
    ]
  }
}
